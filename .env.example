# ===== LLM 配置（必填）=====
# 你的 API Key（OpenAI 官方 或 任意兼容 OpenAI 格式的服务，如 DeepSeek / 月之暗面 / 智谱）
OPENAI_API_KEY=your-api-key-here

# 接口地址（可选）：国内服务填对应 base_url，留空则用 OpenAI 官方 https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com

# 模型名（可选）：默认 gpt-4o-mini，国内服务如 deepseek-chat / deepseek-v4-flash
OPENAI_MODEL=deepseek-v4-flash

# ===== 天气工具（可选，day2/day3 等用百度天气接口时需要）=====
BAIDU_API_KEY=your-baidu-api-key-here
